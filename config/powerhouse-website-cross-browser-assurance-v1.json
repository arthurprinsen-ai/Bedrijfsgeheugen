{
  "version": "POWERHOUSE-WEBSITE-CROSS-BROWSER-ASSURANCE-v1",
  "owner": "powerhouse-terminal-delivery",
  "base_url": "https://www.bedrijfsgeheugen.nl",
  "all_route_sweep": {
    "source": "/sitemap.xml",
    "browsers": [
      "chromium"
    ],
    "viewports": [
      "small-mobile",
      "desktop"
    ],
    "assertions": [
      "http_ok",
      "main_visible",
      "h1_visible",
      "main_text",
      "horizontal_overflow",
      "broken_images",
      "page_errors",
      "failed_document_script_stylesheet"
    ]
  },
  "screenshot_matrix": {
    "browsers": [
      "chromium",
      "firefox",
      "webkit"
    ],
    "viewports": [
      "small-mobile",
      "mobile",
      "tablet",
      "desktop",
      "wide-desktop"
    ],
    "routes": [
      "/",
      "/prijzen",
      "/hoe-het-werkt",
      "/platform",
      "/frisse-blik",
      "/pakketadvies",
      "/contact",
      "/ai-modelwijzer",
      "/due-diligence",
      "/blog",
      "/blog/wet-dba-en-zelfstandigen-wat-verandert-er-en-wat-betekent-dat-voor-jou",
      "/en",
      "/en/prijzen",
      "/en/contact"
    ]
  },
  "viewports": {
    "mobile": {
      "width": 390,
      "height": 844
    },
    "tablet": {
      "width": 768,
      "height": 1024
    },
    "desktop": {
      "width": 1440,
      "height": 900
    },
    "small-mobile": {
      "width": 320,
      "height": 568
    },
    "wide-desktop": {
      "width": 1920,
      "height": 1080
    }
  },
  "thresholds": {
    "horizontal_overflow_px": 4,
    "min_main_text_chars": 80,
    "max_cls": 0.1,
    "min_touch_target_px": 40,
    "max_heading_width_ratio": 1,
    "max_media_viewport_height_ratio": 1.5
  },
  "interactions": [
    {
      "id": "mobile-menu",
      "routes": [
        "/",
        "/prijzen",
        "/contact"
      ],
      "viewport": "mobile",
      "selectorCandidates": [
        "[data-bg-mobile-menu-toggle]",
        "[aria-controls='bg-nav-drawer']",
        ".v17-menu-toggle",
        ".bg-menu-toggle"
      ],
      "assert": "menu_panel_visible"
    },
    {
      "id": "more-menu",
      "routes": [
        "/",
        "/prijzen"
      ],
      "viewport": "desktop",
      "selectorCandidates": [
        "[data-bg-menu-trigger='more']",
        "[data-bg-menu-trigger]"
      ],
      "assert": "controlled_panel_visible"
    },
    {
      "id": "language-switch",
      "routes": [
        "/",
        "/prijzen",
        "/contact"
      ],
      "viewport": "desktop",
      "selectorCandidates": [
        "a[hreflang='en']",
        "a[href^='/en']"
      ],
      "assert": "same_route_english_or_en_home"
    }
  ],
  "rules": [
    "screenshots_required_for_critical_matrix",
    "failure_screenshot_required",
    "all_sitemap_routes_must_be_swept",
    "mobile_and_desktop_required_for_all_routes",
    "chromium_firefox_webkit_required_for_critical_matrix",
    "no_tolerance_widening_to_hide_structural_mismatch",
    "daily_production_run_required",
    "visual_quality_is_a_release_requirement",
    "small_mobile_and_wide_desktop_are_required_edge_viewports",
    "visual_failures_must_be_fixed_not_hidden",
    "daily_gate_uses_bounded_full_sitemap_plus_deep_critical_matrix"
  ],
  "visual_quality_assertions": [
    "no_overlapping_visible_text_or_controls",
    "no_clipped_visible_text",
    "no_horizontal_overflow",
    "images_and_video_fit_viewport",
    "interactive_controls_have_usable_touch_targets",
    "primary_buttons_are_not_truncated",
    "fixed_or_sticky_navigation_does_not_cover_main_heading",
    "critical_cards_do_not_exceed_viewport_width",
    "body_text_remains_readable",
    "screenshots_are_retained_for_visual_review"
  ]
}
