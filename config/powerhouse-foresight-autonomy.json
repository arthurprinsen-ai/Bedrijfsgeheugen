{
  "version": "powerhouse-foresight-autonomy-v2",
  "extends": [
    "powerhouse-daily-self-evolution-v2",
    "powerhouse-self-improvement-layer-v1",
    "powerhouse-autonomous-improvement-runtime-v1"
  ],
  "objective": "Continuously improve Powerhouse's ability to anticipate future company, market, technology, regulation, customer and operational outcomes using calibrated forecasts, scenario ensembles, leading indicators and verified outcome feedback.",
  "control_plane": {
    "systems": [
      "github",
      "notion",
      "supabase",
      "netlify",
      "powerhouse_brain",
      "portal_v2"
    ],
    "one_canonical_truth": true,
    "parallel_authorities_forbidden": true,
    "exact_candidate_identity": true,
    "production_readback_required": true
  },
  "autonomy": {
    "discover_new_code_techniques": true,
    "discover_new_infrastructure": true,
    "discover_new_architecture_patterns": true,
    "generate_experiments": true,
    "run_benchmarks": true,
    "implement_safe_reversible_winners": true,
    "optimize_publishing": true,
    "optimize_integrations": true,
    "optimize_security": true,
    "predict_future_scenarios": true,
    "customer_portal_forecasts": true,
    "hard_boundaries": [
      "secrets_credentials_permissions",
      "security_control_weakening",
      "destructive_irreversible_data",
      "paid_capacity_increase",
      "legal_financial_commitment"
    ],
    "optimize_prediction_quality": true,
    "generate_forecast_challengers": true,
    "resolve_due_forecasts": true,
    "recalibrate_probability_mapping": true,
    "optimize_horizon_estimation": true,
    "expand_independent_signal_diversity": true
  },
  "evidence": {
    "internal": [
      "runtime_metrics",
      "workflow_metrics",
      "production_outcomes",
      "customer_inputs",
      "historical_decisions",
      "incident_learning",
      "cost_latency_quality"
    ],
    "external": [
      "official_docs",
      "release_notes",
      "standards",
      "security_advisories",
      "market_data",
      "sector_benchmarks",
      "macro_data",
      "reputable_research"
    ],
    "provenance_required": true,
    "observed_at_required": true,
    "confidence_required": true,
    "freshness_required": true,
    "uncertainty_required": true
  },
  "experimentation": {
    "lifecycle": [
      "OBSERVE",
      "HYPOTHESIZE",
      "BASELINE",
      "CHALLENGER",
      "REPLAY",
      "BENCHMARK",
      "SHADOW",
      "CANARY",
      "PROMOTE_OR_ROLLBACK",
      "PRODUCTION_OUTCOME"
    ],
    "champion_challenger": true,
    "causal_claims_require_causal_evidence": true,
    "no_magic_score": true,
    "no_change_valid_when_incumbent_wins": true
  },
  "prediction": {
    "horizons": [
      "7d",
      "30d",
      "90d",
      "12m",
      "36m"
    ],
    "methods": [
      "trend",
      "scenario_ensemble",
      "benchmark_gap",
      "driver_based",
      "leading_indicator",
      "base_rate",
      "confidence_interval"
    ],
    "customer_outputs": [
      "expected_path",
      "upside_case",
      "downside_case",
      "benchmark_position",
      "key_drivers",
      "leading_indicators",
      "recommended_actions",
      "confidence",
      "data_freshness"
    ],
    "prediction_is_not_fact": true,
    "backtest_required": true,
    "calibration_required": true,
    "quality_metrics": [
      "brier_score",
      "calibration_error",
      "timing_mae_days",
      "resolution_coverage",
      "signal_diversity"
    ],
    "minimum_resolved_forecasts_for_model_promotion": 20,
    "unresolved_forecasts_are_learning_debt": true,
    "forecast_resolution_required": true,
    "horizon_specific_calibration": true,
    "segment_specific_calibration": true,
    "scenario_ensemble_required_for_material_forecasts": true,
    "challenger_required_when_quality_degrades": true,
    "direct_self_rewrite_forbidden": true,
    "promotion_path": [
      "backtest",
      "shadow",
      "canary",
      "promote_or_rollback"
    ]
  },
  "security": {
    "least_privilege": true,
    "vulnerability_advisories": true,
    "dependency_risk": true,
    "secret_exposure_checks": true,
    "rls_and_tenant_isolation": true,
    "supply_chain_checks": true,
    "rollback_and_recovery": true,
    "security_non_degradation": true
  },
  "terminal_success": "LIVE_BEWEZEN"
}
