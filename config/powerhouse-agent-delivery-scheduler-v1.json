{
  "version": "POWERHOUSE-AGENT-DELIVERY-SCHEDULER-v1",
  "fingerprint": "powerhouse|multi-agent-delivery-scheduler|predict-conflict-capacity-before-write|v1",
  "parallel": {
    "max_non_conflicting_agents": 6,
    "serialize_only_terminal_overlap": true
  },
  "writer_lease": {
    "max_active_writers_per_obligation": 1,
    "head_bound": true
  },
  "queue": {
    "soft_active": 8,
    "soft_queued": 5,
    "hard_active": 12,
    "hard_queued": 8,
    "max_projected_new_runs_per_write": 3
  },
  "async_continuation": {
    "checkpoint_required": true,
    "remote_wait_is_terminal": false,
    "bounded_polling": true,
    "auto_resume": true
  },
  "supersession": {
    "newer_main_supersedes_stale_reversible_production_wait": true,
    "irreversible_side_effects_never_superseded": true
  }
}
