        "zoek",
        "run",
        "afwijz",
        "reject",
        "432",
        "empty",
        "leeg"
      ]
    },
    {
      "ruleId": "EVERY_LOOP_NEEDS_OWNER_AND_STARTER",
      "systems": [
        "heartbeat",
        "agent",
        "lus",
        "loop",
        "cron",
        "schedule"
      ],
      "actions": [
        "new",
        "nieuw",
        "build",
        "bouw",
        "start",
        "schedule"
      ]
    },
    {
      "ruleId": "CHECK_EXTERNAL_EFFECT_BEFORE_REPUBLISH",
      "systems": [
        "linkedin",
        "instagram",
        "buffer",
        "publicat",
        "post"
      ],
      "actions": [
        "republish",
        "opnieuw",
        "retry",
        "gemist",
        "missed"
      ]
    },
    {
      "ruleId": "KEEP_ENTRY_PAGES_READABLE_AND_CORRECT_OLD_STATUS",
      "systems": [
        "notion",
        "start hier"
      ],
      "actions": [
        "update",
        "bijwerk",
        "fetch",
        "read",
        "lees",
        "add",
        "toevoeg"
      ]
    }
  ]
}
