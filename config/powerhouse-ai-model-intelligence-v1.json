{
  "id": "powerhouse-ai-model-intelligence-v1",
  "owner": "Powerhouse Growth & Revenue OS + whole-brain-intelligence",
  "authority": {
    "catalog": "data/ai-model-catalog-v1.json",
    "public_surface": "/ai-modelwijzer",
    "lead_capture": "/api/ai-modelwijzer-lead",
    "runtime": "Supabase/Powerhouse existing commercial outcome lineage"
  },
  "refresh": {
    "cadence": "daily",
    "source_policy": "official-provider-first",
    "fail_closed_on_stale_pricing_days": 14,
    "lifecycle_check": true,
    "pricing_check": true,
    "residency_check": true,
    "sovereignty_check": true,
    "stale_record_policy": "Per-model verified_at and official source are authoritative; stale/unknown governance does not become a positive suitability signal."
  },
  "decision_policy": {
    "user_goal_first": true,
    "no_single_best_model_claim": true,
    "explain_tradeoffs": true,
    "cost_per_task_over_token_price": true,
    "privacy_constraints_can_exclude": true,
    "preview_penalty": true,
    "stale_data_penalty": true,
    "specialist_intent_gate": true,
    "explicit_limitations": true
  },
  "seo": {
    "primary_intent": "AI modellen vergelijken",
    "clusters": [
      "ChatGPT vs Claude",
      "ChatGPT vs Gemini",
      "Claude vs Gemini",
      "beste AI model",
      "beste AI voor programmeren",
      "beste AI voor data analyse",
      "AI model kosten vergelijken",
      "AI data soevereiniteit"
    ]
  },
  "revenue_loop": "search intent -> advisor use -> recommendation -> optional email capture -> qualified lead -> Bedrijfslek/Frisse Blik -> proposal/order -> realized revenue -> learning",
  "system_map_node": "ai-model-intelligence-advisor-v1",
  "version": "powerhouse-ai-model-intelligence-v2",
  "coverage_policy": {
    "objective": "broadest decision-relevant model catalog, including frontier, economy, open-weight and specialist modalities",
    "minimum_seed_models": 110,
    "required_model_families": [
      "general text/reasoning",
      "coding",
      "image generation/editing",
      "realtime/voice",
      "transcription",
      "TTS",
      "OCR/document AI",
      "embeddings/RAG",
      "moderation/safety",
      "video",
      "open-weight/self-host"
    ],
    "include_lifecycle_context": true,
    "explicit_limitations_required": true,
    "governance_unknown_is_not_green": true,
    "source_per_model_required": true,
    "verified_at_per_model_required": true,
    "continuous_expansion": true
  },
  "provider_sources": {
