{
  "version": "BRAIN-DELIVERY-v2",
  "brainContractVersion": "brain.v1",
  "sharedPaths": [
    "AGENTS.md",
    "config/",
    "docs/brain/",
    "docs/development-",
    "docs/outcome-obligations.md",
    "scripts/brain/",
    "brain/contracts/",
    "brain/production/",
    "tools/brain-delivery-system.mjs",
    ".github/workflows/"
  ],
  "ignoredPaths": [
    "docs/development-ledger-events/",
    "docs/superpowers/"
  ],
  "branchPolicy": {
    "strategy": "conflict-aware-independent-lanes",
    "createFrom": "current-main",
    "rebuildOnMainDrift": false,
    "syncRequiredWhen": ["merge-conflict", "changed-path-overlap", "declared-contract-overlap", "declared-dependency-conflict"],
    "nonOverlappingDriftAction": "keep-tested-candidate",
    "preferredWriteMode": "atomic-tree-commit",
    "maxRebuildsForNonOverlappingDrift": 0
  },
  "conflictContracts": [
    {
      "id": "delivery-control-plane",
      "paths": ["AGENTS.md", "config/brain-delivery-system.json", "brain/contracts/delivery-v2.schema.json", "brain/production/continuous-delivery-v2.mjs", "tools/brain-delivery-system.mjs", ".github/workflows/unified-brain-delivery.yml"]
    },
    {
      "id": "brain-governance",
      "paths": ["config/outcome-obligations.json", "docs/brain/component-registry.json"]
    },
    {
      "id": "supabase-schema",
      "paths": ["supabase/migrations/", "supabase/schema/"]
    },
    {
      "id": "make-contract",
      "paths": ["make/contracts/", "automation/contracts/"]
    },
    {
      "id": "notion-contract",
      "paths": ["notion/contracts/"]
    },
    {
      "id": "dataforseo-contract",
      "paths": ["dataforseo/contracts/", "integrations/dataforseo/contracts/"]
    },
    {
      "id": "netlify-routing",
      "paths": ["netlify.toml", "netlify/redirects/"]
    }
  ],
  "lanes": [
    {
      "id": "backend",
      "owner": "agent-integration-make",
      "paths": ["brain/", "platform/", "netlify/functions/", "scripts/brain/"],
      "requiredContracts": ["BG166", "BG167", "BG168", "BG169"]
    },
    {
      "id": "portal",
      "owner": "agent-product-opportunity",
      "paths": ["portal/", "klantportaal.html", "netlify/functions/portaalvraag.mjs", "netlify/functions/portal-state.mjs"],
      "requiredContracts": ["BG166", "BG167", "BG168", "BG169"]
    },
    {
      "id": "website",
      "owner": "agent-website-ux",
      "paths": ["components/", "assets/", "pages/", "site/", "index.html", "styles.css", "script.js"],
      "requiredContracts": ["BG166", "BG167", "BG168", "BG169"]
    },
    {
      "id": "automation",
      "owner": "agent-integration-make",
      "paths": ["automation/", "make/", "notion/"],
      "requiredContracts": ["BG166", "BG167", "BG168", "BG169"]
    }
  ],
  "integration": {
    "owner": "agent-reliability",
    "singleCandidate": false,
    "independentPromotion": true,
    "exactShaRequired": true,
    "productionAuthority": "BG169",
    "outcomeRouter": "BG168",
    "currentStateProjection": "BG167",
    "errorLedger": "BG166"
  },
  "registration": {
    "required": true,
    "autoDiscover": true,
    "appliesTo": ["app", "agent", "make_scenario", "github_workflow", "website", "portal", "backend", "service", "notion_projection"]
  }
}
