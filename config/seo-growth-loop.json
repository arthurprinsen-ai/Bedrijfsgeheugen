      "route-outcomes-to-BG168-BG166-BG167"
    ]
  },
  "failure_policy": {
    "unknown_producer": "fail_closed",
    "paused_capacity": "persist dedupeable open learning obligation; no retry storm",
    "browser_delivery": "best_effort_non_blocking",
    "claim_runtime_learning_without_readback": false
  },
  "opportunity_intelligence": {
    "resolver": "powerhouse-seo-opportunity-resolver-v1",
    "opportunity_store": "powerhouse_content_recommendations",
    "forecast_store": "powerhouse_forecasts",
    "canonical_owner_sources": [
      "site/seo-order-map.json",
      "site/seo-order-expansion.json"
    ],
    "decision_states": [
      "UPDATE_MONEY_PAGE",
      "CREATE_INTENT_GAP_CONTENT",
      "NO_ACTION_EVIDENCE_INSUFFICIENT"
    ],
    "first_mover_objective": "detect commercially meaningful Dutch search demand early, combine with external market signals, and publish through the existing protected content chain only when a distinct intent gap is proven",
    "execution_guard": "no duplicate publisher; no direct main; exact production readback remains terminal proof"
  }
