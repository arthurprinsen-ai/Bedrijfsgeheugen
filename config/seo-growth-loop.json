{
  "version": "seo-growth-loop-v2",
  "producer_id": "seo-growth-observation",
  "adapter": "BG211",
  "canonical_learning_path": "BG211 -> BG168 -> BG166 -> BG167",
  "canonical_graph_path": "BG211 -> BG205",
  "runtime_ingest": {
    "browser_endpoint": "https://www.bedrijfsgeheugen.nl/api/growth-event",
    "queue": "netlify-blobs:bg-growth-events",
    "delivery": "server-side only",
    "brain_success_requires": "BG211 execution plus durable target readback"
  },
  "privacy": {
    "classification": "non-pii-analytics",
    "forbidden_fields": [
      "email",
      "e-mail",
      "phone",
      "telefoon",
      "name",
      "naam",
      "message",
      "bericht",
      "form",
      "address",
      "adres",
      "ip",
      "user_agent",
      "useragent"
    ],
    "free_text": "forbidden"
  },
  "events": [
    "page_view",
    "organic_landing",
    "money_link_click",
    "primary_cta_click",
    "secondary_cta_click",
    "engaged_view",
    "selfscan_start",
    "frisse_blik_start",
    "lead_outcome",
    "order_outcome"
  ],
  "search_sources": {
    "preferred": [
      "google-search-console"
    ],
    "supplemental": [
      "dataforseo"
    ],
    "paid_provider_guard": "deterministic opportunity pre-gate and bounded paid canary only"
  },
  "optimization": {
    "mode": "bounded",
    "allowlist_config": "config/seo-optimization-allowlist.json",
    "objective": "qualified organic demand -> message match -> engaged visit -> CTA -> qualified lead -> order -> revenue -> outcome learning",
    "traffic_only_selection": false,
    "commercial_priority_formula": "intent_strength * search_demand * ranking_feasibility * conversion_gap * expected_order_value",
    "max_high_confidence_changes_per_daily_cycle": 3,
    "models": [
      "search-intent-mapping",
      "jobs-to-be-done",
      "PAS",
      "AIDA",
      "4P",
      "risk-reversal",
      "message-match",
      "information-scent",
      "topic-clusters",
      "E-E-A-T-evidence",
      "conversion-hierarchy",
      "objection-handling",
      "outcome-memory",
      "cialdini-reciprocity",
      "cialdini-authority",
      "cialdini-social-proof",
      "cialdini-commitment-consistency",
      "cialdini-liking-unity",
      "loss-aversion",
      "prospect-theory-framing",
      "fogg-behavior-model",
      "hick-hyman-choice-reduction",
      "cognitive-fluency",
      "progressive-disclosure",
      "commitment-ladder",
      "specificity-effect",
      "zeigarnik-open-loop",
      "choice-architecture"
    ],
    "money_page_contract": [
      "one-primary-intent",
      "problem-outcome-fit",
      "buyer-language",
      "specific-proof",
      "price-or-effort-expectation",
      "risk-reversal",
      "primary-cta",
      "lower-friction-secondary-cta",
      "buying-objection-faq",
      "contextual-internal-links",
      "cta-instrumentation",
      "single-dominant-value-proposition",
      "visual-attention-hierarchy",
      "benefit-before-feature",
      "loss-and-gain-framing",
      "proof-next-to-claim",
      "choice-reduction",
      "progressive-commitment",
      "friction-audit",
      "trust-architecture",
      "ethical-persuasion-only"
    ],
    "guardrails": [
      "people-first",
      "no-doorway-pages",
      "no-scaled-thin-content",
      "no-keyword-stuffing",
      "no-link-schemes",
      "no-cloaking",
      "schema-must-match-visible-current-content",
      "no-duplicate-intent-pages",
      "no-unverified-testimonials-or-results"
    ],
    "priority_intents_baseline_2026_09_29": [
      {
        "query": "bedrijfsprocessen automatiseren",
        "nl_monthly_search_volume": 480,
        "role": "money"
      },
      {
        "query": "afas koppeling",
        "nl_monthly_search_volume": 320,
        "role": "money"
      },
      {
        "query": "exact online koppeling",
        "nl_monthly_search_volume": 140,
        "role": "money"
      },
      {
        "query": "power bi implementatie",
        "nl_monthly_search_volume": 50,
        "role": "money"
      },
      {
        "query": "kennisborging",
        "nl_monthly_search_volume": 40,
        "role": "support"
      },
      {
        "query": "ai automatisering mkb",
        "nl_monthly_search_volume": 20,
        "role": "money"
      }
    ],
    "daily_cycle": [
      "observe-production-and-search-evidence",
      "detect-ranking-content-schema-cro-and-link-gaps",
      "prioritize-by-commercial-value",
      "apply-up-to-three-reversible-high-confidence-changes",
      "validate-technical-seo-content-and-conversion-contracts",
      "protected-delivery-and-production-readback",
      "measure-qualified-leads-orders-and-revenue",
      "route-outcomes-to-BG168-BG166-BG167"
    ],
    "behavioral_decision_engine": {
      "objective": "maximize qualified_order_probability and realized_revenue without increasing deception, friction or contact pressure",
      "sequence": [
        "attention",
        "relevance",
        "problem",
        "consequence",
        "desired-outcome",
        "mechanism",
        "proof",
        "risk-removal",
        "action"
      ],
      "visitor_state_inputs": [
        "landing_intent",
        "traffic_source",
        "new_or_returning",
        "page_depth",
        "cta_history",
        "known_company_context_non_pii",
        "funnel_stage",
        "device_class"
      ],
      "decisions": [
        "hero-message",
        "proof-order",
        "primary-cta",
        "secondary-cta",
        "objection-block",
        "risk-reversal",
        "pricing-anchor",
        "scan-or-conversation-path",
        "page-section-order"
      ],
      "evidence_policy": "prefer observed conversion and terminal revenue outcomes; use heuristic priors only until sufficient evidence exists",
      "optimization_metric_order": [
        "realized_revenue",
        "paid_orders",
        "qualified_proposals",
        "qualified_meetings",
        "qualified_leads",
        "cta_progression",
        "engaged_view"
      ],
      "autonomy": {
        "decision_mode": "contextual evidence-gated",
        "winner_promotion_requires_terminal_outcomes_when_available": true,
        "fallback_when_sample_insufficient": "retain incumbent or bounded heuristic challenger",
        "rollback_on_guardrail_regression": true,
        "no_dark_patterns": true
      }
    },
    "experiment_policy": {
      "unit": "canonical money page + intent + visitor context",
      "challenger_budget": "bounded within existing max_high_confidence_changes_per_daily_cycle",
      "promote_when": "material lift with sufficient evidence and no trust/quality regression",
      "demote_when": "qualified conversion or terminal outcome regresses beyond configured tolerance",
      "never_optimize_for": [
        "clickbait_ctr",
        "raw_scroll_depth",
        "time_on_page_without_downstream_value"
      ]
    },
    "daily_terminal_contract": {
      "version": "seo-cro-execute-or-explain-v1",
      "material_opportunity_requires_terminal_state": true,
      "terminal_states": [
        "EXECUTED",
        "REJECTED_WITH_EVIDENCE"
      ],
      "recommendation_only_is_contract_failure": true,
      "execute_when_safe_reversible_evidence_gated_change_exists": true,
      "max_changes_per_cycle": 3,
      "rejection_reason_codes": [
        "INSUFFICIENT_SEARCH_EVIDENCE",
        "INSUFFICIENT_CONVERSION_EVIDENCE",
        "CANONICAL_OWNER_ALREADY_SERVES_INTENT",
        "CANNIBALIZATION_RISK",
        "EXPECTED_ORDER_VALUE_TOO_LOW",
        "GUARDRAIL_OR_TRUST_RISK",
        "HUMAN_AUTHORITY_REQUIRED",
        "NO_SAFE_REVERSIBLE_CHANGE"
      ],
      "rejection_evidence_required": [
        "opportunity_or_query",
        "canonical_owner",
        "evidence_inspected_and_freshness",
        "reason_code",
        "missing_or_conflicting_evidence",
        "future_execution_condition"
      ],
      "transient_ci_or_tool_failure_is_recovery_not_rejection": true,
      "operator_output": "executed change plus production/readback state, or evidence-backed non-execution reason"
    }
  },
  "failure_policy": {
    "unknown_producer": "fail_closed",
    "paused_capacity": "persist dedupeable open learning obligation; no retry storm",
    "browser_delivery": "best_effort_non_blocking",
    "claim_runtime_learning_without_readback": false
  },
  "opportunity_intelligence": {
    "resolver": "powerhouse-seo-opportunity-resolver-v1",
    "opportunity_store": "powerhouse_content_recommendations",
    "forecast_store": "powerhouse_forecasts",
    "canonical_owner_sources": [
      "site/seo-order-map.json",
      "site/seo-order-expansion.json"
    ],
    "decision_states": [
      "UPDATE_MONEY_PAGE",
      "CREATE_INTENT_GAP_CONTENT",
      "NO_ACTION_EVIDENCE_INSUFFICIENT"
    ],
    "first_mover_objective": "detect commercially meaningful Dutch search demand early, combine with external market signals, and publish through the existing protected content chain only when a distinct intent gap is proven",
    "execution_guard": "no duplicate publisher; no direct main; exact production readback remains terminal proof"
  }
}
