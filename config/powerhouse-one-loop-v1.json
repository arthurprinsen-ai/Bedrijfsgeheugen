{
  "version": "POWERHOUSE-ONE-LOOP-v1",
  "extends": ["POWERHOUSE-DELIVERY-HYGIENE-v1", "BRAIN-DELIVERY-v2"],
  "terminalStates": ["LIVE_PROVEN", "FULFILLED", "BLOCKED_EXTERNAL"],
  "recoverableStates": [
    "COMMITTED",
    "PR_OPEN",
    "CI_QUEUED",
    "TIMEOUT",
    "CHAT_STOPPED",
    "WORKER_LOST",
    "LEASE_EXPIRED",
    "RETRYABLE_FAILURE",
    "INTERRUPTED",
    "WAITING_CAPACITY",
    "RECONCILING"
  ],
  "lifecycle": [
    "DISCOVERED",
    "ADMITTED",
    "EXECUTING",
    "VERIFIED",
    "MERGE_READY",
    "MERGED",
    "DEPLOYED",
    "LIVE_PROVEN",
    "LEARNED",
    "FULFILLED"
  ],
  "completionEvidence": [
    "exactHeadVerified",
    "protectedMergeVerified",
    "runtimeReadbackVerified",
    "learningWritebackVerified"
  ],
  "recovery": {
    "requiresHeartbeat": true,
    "requiresLease": true,
    "idempotentReadbackBeforeRetry": true,
    "oneActiveCandidatePerObligation": true
  },
  "optimization": {
    "finishBeforeStart": true,
    "securityIncidentPriority": true,
    "neverWeakenSecurityIntegrityTruthReleaseEvidenceGates": true
  },
  "githubLearningSignals": [
    "queue_ms",
    "workflow_runtime_ms",
    "reruns",
    "failed_attempts",
    "merge_conflicts",
    "main_movements",
    "supersession",
    "obligation_to_live_ms",
    "obligation_to_fulfilled_ms"
  ]
}
