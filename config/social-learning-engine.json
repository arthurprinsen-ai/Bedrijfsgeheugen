{
  "version": "SOCIAL-LEARNING-v2",
  "windowsHours": [
    24,
    48,
    72
  ],
  "windowToleranceHours": 6,
  "promotion": {
    "minSampleSize": 5,
    "minPublicationDates": 2,
    "minConfidence": 0.75
  },
  "explorationTarget": 0.2,
  "metricPriority": [
    "revenue",
    "orders",
    "offers",
    "qualified_leads",
    "meetings",
    "dms",
    "substantive_interactions",
    "clicks",
    "likes",
    "reactions"
  ],
  "creativePolicy": {
    "personalLinkedIn": {
      "defaultTextType": "verified_first_person_personal_life_story",
      "sourceContract": "personal-linkedin-personal-life-only-v1",
      "verifiedUnusedUserFactRequired": true,
      "publishAuthority": "original_personal_source_final_review_and_provider_gate_only",
      "allowedDays": "monday_to_saturday",
      "requiredDimensions": [
        "verified_personal_event",
        "human_detail",
        "natural_twist",
        "authentic_first_person_voice",
        "story_family_uniqueness",
        "privacy_clearance"
      ],
      "ctaMode": "natural_noncommercial_question_optional",
      "objective": "authentic_personal_conversation",
      "separateFromCompanyLearning": true,
      "commercialConversionOptimizationForbidden": true,
      "externalNewsOrBusinessFallbackForbidden": true,
      "promoteWinnerOnlyWithIndependentPersonalMetrics": true,
      "personalMetricPriority": [
        "substantive_interactions",
        "comments",
        "shares",
        "reactions",
        "profile_visits"
      ],
      "insufficientMetricsOutcome": "NOT_MEASURED"
    },
    "companyLinkedIn": {
      "preferredFormats": [
        "carousel",
        "case_proof",
        "diagnostic"
      ],
      "requiredDimensions": [
        "proof_type",
        "offer_type",
        "pain_trigger",
        "commercial_hypothesis"
      ],
      "objective": "qualified_demand"
    },
    "blog": {
      "defaultTextType": "search_demand_to_problem_activation",
      "objective": "organic_qualified_demand",
      "consumeSeoOpportunitySignals": true
    },
    "latentProblemActivation": true,
    "generateFinalCopyNearPublish": true,
    "avoid": [
      "fabricated_story",
      "generic_ai_slogan",
      "manufactured_outrage",
      "repetitive_cta"
    ]
  },
  "sourceSignals": [
    "social_learning",
    "revenue_learning",
    "seo_growth",
    "site_analytics",
    "network_relationships",
    "sales_outcomes",
    "powerhouse_opportunities"
  ]
}
