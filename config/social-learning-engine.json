{
  "version": "SOCIAL-LEARNING-v2",
  "windowsHours": [24, 48, 72],
  "windowToleranceHours": 6,
  "promotion": {
    "minSampleSize": 5,
    "minPublicationDates": 2,
    "minConfidence": 0.75
  },
  "explorationTarget": 0.2,
  "metricPriority": [
    "revenue",
    "orders",
    "offers",
    "qualified_leads",
    "meetings",
    "dms",
    "substantive_interactions",
    "clicks",
    "likes"
  ],
  "creativePolicy": {
    "personalLinkedIn": {
      "defaultTextType": "observational_business_standup",
      "requiredDimensions": ["emotion", "comedy_device", "pain_trigger", "cta_type", "commercial_hypothesis"],
      "ctaMode": "conversation_first",
      "objective": "commercial_conversation"
    },
    "companyLinkedIn": {
      "preferredFormats": ["carousel", "case_proof", "diagnostic"],
      "requiredDimensions": ["proof_type", "offer_type", "pain_trigger", "commercial_hypothesis"],
      "objective": "qualified_demand"
    },
    "blog": {
      "defaultTextType": "search_demand_to_problem_activation",
      "objective": "organic_qualified_demand",
      "consumeSeoOpportunitySignals": true
    },
    "latentProblemActivation": true,
    "generateFinalCopyNearPublish": true,
    "avoid": ["fabricated_story", "generic_ai_slogan", "manufactured_outrage", "repetitive_cta"]
  },
  "sourceSignals": ["social_learning", "revenue_learning", "seo_growth", "site_analytics", "network_relationships", "sales_outcomes", "powerhouse_opportunities"]
}
