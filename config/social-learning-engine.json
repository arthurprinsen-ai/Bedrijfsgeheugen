{
  "version": "SOCIAL-LEARNING-v2",
  "windowsHours": [
    24,
    48,
    72
  ],
  "windowToleranceHours": 6,
  "promotion": {
    "minSampleSize": 5,
    "minPublicationDates": 2,
    "minConfidence": 0.75
  },
  "explorationTarget": 0.2,
  "metricPriority": [
    "revenue",
    "orders",
    "offers",
    "qualified_leads",
    "meetings",
    "dms",
    "substantive_interactions",
    "clicks",
    "likes",
    "reactions"
  ],
  "creativePolicy": {
    "personalLinkedIn": {
      "defaultTextType": "verified_first_person_personal_life_story",
      "sourceContract": "personal-linkedin-personal-life-only-v1",
      "verifiedUnusedUserFactRequired": true,
      "publishAuthority": "original_personal_source_final_review_and_provider_gate_only",
      "allowedDays": "monday_to_saturday",
      "requiredDimensions": [
        "verified_personal_event",
        "human_detail",
        "authentic_first_person_voice",
        "story_family_uniqueness",
        "privacy_clearance"
      ],
      "ctaMode": "not_required_only_when_natural",
      "objective": "authentic_personal_conversation",
      "separateFromCompanyLearning": true,
      "commercialConversionOptimizationForbidden": true,
      "externalNewsOrBusinessFallbackForbidden": true,
      "promoteWinnerOnlyWithIndependentPersonalMetrics": true,
      "personalMetricPriority": [
        "substantive_interactions",
        "comments",
        "shares",
        "reactions",
        "profile_visits"
      ],
      "insufficientMetricsOutcome": "NOT_MEASURED",
      "declutterComplexity": true,
      "sourceDeterminesNarrativeShape": true,
      "mandatoryHook": false,
      "mandatoryTwist": false,
      "mandatoryHumor": false,
      "mandatoryQuestion": false,
      "mandatoryMoral": false,
      "patternDiversityDimensions": [
        "opening",
        "narrative_arc",
        "length",
        "humor",
        "ending"
      ],
      "repeatedPatternOutcome": "REWRITE_NOT_PUBLISH",
      "researchEvidenceLastReviewedAt": "2026-11-16",
      "automatedCommentsForbidden": true,
      "engagementPodsForbidden": true,
      "unauthorizedProfileScrapingForbidden": true,
      "imageUse": "optional_only_with_source_and_media_rights",
      "recentPublishedPatternCheck": "original_independent_reviewer_history_45_days",
      "learningWindowsHours": [
        24,
        48,
        72
      ],
      "metricSource": "original_linkedin_authorized_post_analytics_only",
      "noMetricsOrNoTruth": "OPEN_NOT_MEASURED_OR_SOURCE_REQUIRED",
      "outcomePriority": [
        "authentic_replies",
        "meaningful_comments",
        "saves_if_authorized",
        "profile_visits_if_authorized",
        "impressions_if_authorized",
        "reactions"
      ]
    },
    "companyLinkedIn": {
      "preferredFormats": [
        "carousel",
        "case_proof",
        "diagnostic"
      ],
      "requiredDimensions": [
        "proof_type",
        "offer_type",
        "pain_trigger",
        "commercial_hypothesis"
      ],
      "objective": "qualified_demand"
    },
    "blog": {
      "defaultTextType": "search_demand_to_problem_activation",
      "objective": "organic_qualified_demand",
      "consumeSeoOpportunitySignals": true
    },
    "latentProblemActivation": true,
    "generateFinalCopyNearPublish": true,
    "avoid": [
      "fabricated_story",
      "generic_ai_slogan",
      "manufactured_outrage",
      "repetitive_cta"
    ]
  },
  "sourceSignals": [
    "social_learning",
    "revenue_learning",
    "seo_growth",
    "site_analytics",
    "network_relationships",
    "sales_outcomes",
    "powerhouse_opportunities"
  ]
}
