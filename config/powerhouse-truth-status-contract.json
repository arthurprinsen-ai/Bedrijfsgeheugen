{
  "version": "POWERHOUSE-TRUTH-STATUS-v1",
  "canonical": true,
  "scope": "all-current-and-future-agents-chats-workflows",
  "purpose": "Voorkom dat onbewezen claims als live, klaar, groen, opgelost of geborgd als operationele waarheid worden behandeld.",
  "executionStatuses": [
    "LIVE_BEWEZEN",
    "DEELS_LIVE",
    "GEBLOKKEERD",
    "NIET_GEDAAN"
  ],
  "verificationStates": [
    "VERIFIED",
    "UNVERIFIED_LEGACY"
  ],
  "legacyPolicy": {
    "historicalChatClaimsDefaultTo": "UNVERIFIED_LEGACY",
    "claims": [
      "live",
      "klaar",
      "groen",
      "opgelost",
      "geborgd"
    ],
    "promotionRequiresCurrentProductionEvidence": true,
    "chatTextNeverOverridesCanonicalRuntimeEvidence": true
  },
  "requiredFields": [
    "status",
    "verification_state",
    "production_ref",
    "evidence",
    "gates",
    "open_gaps",
    "powerhouse_writeback",
    "next_action",
    "updated_at"
  ],
  "liveProvenInvariant": {
    "status": "LIVE_BEWEZEN",
    "requires": {
      "verification_state": "VERIFIED",
      "production_ref_present": true,
      "evidence_non_empty": true,
      "all_required_gates_green": true,
      "open_gaps_empty": true,
      "powerhouse_writeback_verified": true
    }
  },
  "partialInvariant": {
    "status": "DEELS_LIVE",
    "rule": "Gebruik zodra enig vereist productie-, gate-, evidence- of writebackonderdeel nog ontbreekt terwijl een deel aantoonbaar live is."
  },
  "blockedInvariant": {
    "status": "GEBLOKKEERD",
    "rule": "Gebruik uitsluitend met concrete blocker en next_action; een blocker mag nooit als groen worden samengevat."
  },
  "notDoneInvariant": {
    "status": "NIET_GEDAAN",
    "rule": "Gebruik wanneer de gevraagde materiële verandering niet aantoonbaar is uitgevoerd."
  },
  "writebackPolicy": {
    "reuseExistingPowerhouseLineage": true,
    "parallelTruthStoreForbidden": true,
    "materialOutcomeType": "CONTRACT_CHANGE",
    "runtimeEventRequired": true,
    "learningWritebackRequired": true,
    "sharedContextRefreshRequired": true
  },
  "failClosed": true,
  "userFacingReportingPolicy": {
    "fingerprint": "delivery|user-facing-reporting|terminal-outcomes-only|v1",
    "default_mode": "TERMINAL_OUTCOMES_ONLY",
    "internal_states_hidden_from_chat": [
      "branch_ref",
      "commit_sha",
      "pr_head_ref_sync",
      "queued_or_running_ci",
      "branch_protection_wait",
      "deploy_progress",
      "provider_polling",
      "retry_state",
      "not_yet_live_bewezen"
    ],
    "allowed_user_facing_states": [
      "LIVE_BEWEZEN",
      "ROLLED_BACK_GREEN",
      "BLOCKED_HARD_BOUNDARY"
    ],
    "blocked_hard_boundary_output": "minimum_external_human_action_only",
    "technical_details_on_explicit_user_request_only": true,
    "interruption_is_not_handoff": true,
    "continuation_fingerprint": "delivery|terminal-continuation|no-internal-handoff|v2",
    "owner_must_continue_until_terminal": true,
    "internal_blocker_is_stop_condition": false,
    "chat_or_client_timeout_cancels_obligation": false,
    "user_retry_or_continue_required": false,
    "resume_from_canonical_checkpoint": true,
    "dedupe_side_effects_after_interruption": true
  }
}
