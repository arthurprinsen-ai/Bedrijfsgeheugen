{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BRAIN-DELIVERY-v2",
  "title": "BRAIN Continuous Delivery v2 Manifest",
  "type": "object",
  "required": ["contract","change_id","component_id","lane_id","component_type","candidate_identity","tested_identity","registered","brain_context_loaded","learning_writeback_configured","rollback_identity","gates","scopes","dependencies","production"],
  "properties": {
    "contract": {"const":"BRAIN-DELIVERY-v2"},
    "change_id": {"type":"string","minLength":1},
    "component_id": {"type":"string","minLength":1},
    "lane_id": {"type":"string","minLength":1},
    "component_type": {"enum":["app","agent","make_scenario","github_workflow","website","portal","backend","service","notion_projection","other"]},
    "candidate_identity": {"type":"string","minLength":1},
    "tested_identity": {"type":"string","minLength":1},
    "registered": {"type":"boolean"},
    "brain_context_loaded": {"type":"boolean"},
    "learning_writeback_configured": {"type":"boolean"},
    "rollback_identity": {"type":"string","minLength":1},
    "scopes": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "gates": {
      "type":"object",
      "required":["contract","quality","security","cost_performance","preview"],
      "properties": {
        "contract":{"type":"boolean"},"quality":{"type":"boolean"},"security":{"type":"boolean"},"cost_performance":{"type":"boolean"},"preview":{"type":"boolean"}
      },
      "additionalProperties":true
    },
    "production": {
      "type":"object",
      "required":["status","deployed_identity"],
      "properties":{"status":{"enum":["PENDING","GREEN","RED"]},"deployed_identity":{"type":"string"}},
      "additionalProperties":true
    }
  },
  "additionalProperties": true
}
