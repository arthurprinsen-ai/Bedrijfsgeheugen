{
  "id": "production-readback-v1",
  "owner": "delivery-control-plane",
  "system": "BRAIN/Powerhouse",
  "status": "canonical",
  "sourceOfTruth": ".github/workflows/production-release-readback.yml",
  "requiredGate": "Required test",
  "contractTest": "tests/brain-production-release-readback-scope.test.mjs",
  "principles": {
    "failClosed": true,
    "noParallelReleaseMechanism": true,
    "noMakeDependency": true,
    "exactReleaseIdentity": true,
    "contentReadbackRequired": true,
    "transient5xxPolicy": "bounded-retry-then-fail-closed"
  },
  "productionTruth": {
    "requiredStatusContext": "test",
    "requiredStatusMustBe": "success",
    "redGateMergeAllowed": false,
    "stalePrCanBeCurrentTruth": false,
    "supersededPrCanBeActiveWork": false,
    "netlifyReadyWithoutShaMatchIsLive": false,
    "exactMainToProductionShaMatchRequired": true,
    "liveReadbackRequired": true,
    "requiredLineage": [
      "source_pr",
      "head_sha",
      "delivery_pr",
      "main_sha",
      "netlify_deploy_id",
      "netlify_commit_ref",
      "live_readback"
    ],
    "sharedNetlifyRuntimeDeploymentRequired": true,
    "sharedNetlifyRuntimePrefixes": [
      "platform/api/",
      "platform/saas/",
      "platform/connectors/",
      "platform/read-models/"
    ]
  },
  "connectorReadiness": {
    "maxAttempts": 8,
    "connectTimeoutSeconds": 10,
    "maxRequestSeconds": 30,
    "cacheBust": true,
    "terminalFailure": true,
    "publicRoute": "/api/connectors/readiness",
    "excludedFromAuthenticatedWildcard": true
  },
  "websiteReadback": {
    "exactCommitMarker": true,
    "routes": [
      "/",
      "/prijzen",
      "/over-ons"
    ],
    "maxAttempts": 40,
    "contentAndShellVerification": true
  },
  "learning": {
    "contract": "BRAIN-CLOSED-LOOP-v1",
    "scope": "estate-wide",
    "eventKind": "ERROR",
    "fingerprint": "production-readback-http-5xx-v1",
    "rootCausePolicy": "evidence-before-hypothesis",
    "preventionRule": "ISOLATE_PUBLIC_READINESS_AND_REQUIRE_EXACT_PRODUCTION_READBACK",
    "regressionTest": "tests/brain-production-release-readback-scope.test.mjs",
    "writeback": "canonical-universal-learning",
    "knownLesson": "docs/brain/lessons/production-readback-readiness-503-2026-09-15.json",
    "requiredFields": [
      "fingerprint",
      "event_kind",
      "stage",
      "component_type",
      "component_id",
      "owner",
      "reason",
      "rootCause",
      "failedApproach",
      "fix",
      "preventionRule",
      "regressionTest",
      "evidence",
      "status",
      "first_seen",
      "last_seen",
      "last_changed",
      "evidence_hash",
      "retry_budget",
      "required_intervention",
      "next_escalation_at"
    ]
  }
}
