{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"brain.v1/revenue-content-experiment",
  "type":"object",
  "required":["date","experimentId","experimentFamily","mode","personal","company","copyPolicy"],
  "properties":{
    "date":{"type":"string","format":"date"},
    "experimentId":{"type":"string","minLength":1},
    "experimentFamily":{"type":"string","minLength":1},
    "mode":{"enum":["EXPLORE","EXPLOIT"]},
    "sourceSignals":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "copyPolicy":{"const":"generate_near_publish_from_latest_learning"},
    "personal":{"$ref":"#/$defs/recipe"},
    "company":{"$ref":"#/$defs/recipe"},
    "blog":{"$ref":"#/$defs/recipe"}
  },
  "$defs":{
    "recipe":{
      "type":"object",
      "required":["channel","mode","textType","format","emotion","painTrigger","fomoTrigger","proofType","ctaType","offerType","objective"],
      "properties":{
        "channel":{"type":"string"},
        "mode":{"enum":["EXPLORE","EXPLOIT"]},
        "textType":{"type":"string"},
        "format":{"type":"string"},
        "emotion":{"type":"string"},
        "comedyDevice":{"type":"string"},
        "painTrigger":{"type":"string"},
        "fomoTrigger":{"type":"string"},
        "proofType":{"type":"string"},
        "ctaType":{"type":"string"},
        "offerType":{"type":"string"},
        "objective":{"type":"string"},
        "topic":{"type":["string","null"]}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
