{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BRAIN-PLATFORM-ADAPTER-v1",
  "title": "Brain Universal Platform Adapter Contract",
  "type": "object",
  "required": ["contract","platform","component_types","compatibility_mapping","regression_contract","delivery","telemetry","memory","security","cost","evidence"],
  "properties": {
    "contract": {"const": "BRAIN-PLATFORM-ADAPTER-v1"},
    "platform": {"type": "string", "minLength": 1},
    "component_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compatibility_mapping": {
      "type": "object",
      "required": ["canonical_contract","legacy_inputs_preserved","versioned_mapping","unknown_field_policy"],
      "properties": {
        "canonical_contract": {"type": "string", "minLength": 1},
        "legacy_inputs_preserved": {"const": true},
        "versioned_mapping": {"const": true},
        "unknown_field_policy": {"enum": ["preserve","quarantine","fail_closed"]}
      },
      "additionalProperties": true
    },
    "regression_contract": {
      "type": "object",
      "required": ["required","contract_tests","behavior_parity","rollback_verified"],
      "properties": {
        "required": {"const": true},
        "contract_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "behavior_parity": {"const": true},
        "rollback_verified": {"const": true}
      },
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "required": ["contract","independent_promotion","exact_revision_required","production_authority","activation_gate"],
      "properties": {
        "contract": {"const": "BRAIN-DELIVERY-v2"},
        "independent_promotion": {"const": true},
        "exact_revision_required": {"const": true},
        "production_authority": {"const": "BG169"},
        "activation_gate": {"const": "fail_closed"}
      },
      "additionalProperties": true
    },
    "telemetry": {
      "type": "object",
      "required": ["health","freshness","errors","owner","revision","runtime"],
      "properties": {
        "health": {"const": true},
        "freshness": {"const": true},
        "errors": {"const": true},
        "owner": {"const": true},
        "revision": {"const": true},
        "runtime": {"const": true}
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "required": ["read","writeback","error_ledger","state_projection","outcome_router"],
      "properties": {
        "read": {"const": "BG167"},
        "writeback": {"const": true},
        "error_ledger": {"const": "BG166"},
        "state_projection": {"const": "BG167"},
        "outcome_router": {"const": "BG168"}
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": ["policy_enforced","tenant_scope","secrets_outside_repository"],
      "properties": {
        "policy_enforced": {"const": true},
        "tenant_scope": {"const": true},
        "secrets_outside_repository": {"const": true}
      },
      "additionalProperties": true
    },
    "cost": {
      "type": "object",
      "required": ["metered","daily_optimization","protected_quality_floor"],
      "properties": {
        "metered": {"const": true},
        "daily_optimization": {"const": true},
        "protected_quality_floor": {"const": true}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["source_identity","tested_revision","production_revision","outcome_verified"],
      "properties": {
        "source_identity": {"type": "string", "minLength": 1},
        "tested_revision": {"type": "string", "minLength": 1},
        "production_revision": {"type": "string"},
        "outcome_verified": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
