# HTML wordt bewust NIET bewaard door de browser (no-store). Met
# max-age=0, must-revalidate bleef Safari op een oude versie hangen, ook na
# verversen. Afbeeldingen, stijl en scripts houden hun eigen langere cache:
# die regels staan verderop en zijn specifieker.
/*
  Cache-Control: no-store, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=30, stale-while-revalidate=30
  Vary: *
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/versie.txt
  Cache-Control: no-store, max-age=0

/data/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/kop.css
  Cache-Control: public, max-age=300, must-revalidate

/assets/js/portaalslot.js
  Cache-Control: public, max-age=300, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate
