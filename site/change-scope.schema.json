{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bedrijfsgeheugen.nl/schemas/site-change-scope.json",
  "title": "Bedrijfsgeheugen protected website change scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["routes", "change_class", "preserve"],
  "properties": {
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "change_class": {
      "type": "string",
      "enum": ["approved-content-change", "semantic-restoration", "navigation-only", "technical-only"]
    },
    "preserve": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["seo", "navigation", "required-anchors", "assets", "analytics", "security", "portal", "brain"]}
    },
    "reason": {"type": "string", "minLength": 1},
    "approved_baseline": {"type": "string", "minLength": 1}
  }
}
