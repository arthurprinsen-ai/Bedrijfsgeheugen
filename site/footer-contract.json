{
  "schemaVersion": 1,
  "status": "production-governance",
  "canonicalSource": ".github/canoniek/voet.html",
  "requiredScopes": ["component:footer", "area:seo"],
  "governedGlobs": ["*.html", "blog/index.html", "blog/*/index.html"],
  "exceptions": [
    {"file":"404.html","reason":"error surface; noindex"},
    {"file":"klantportaal.html","reason":"authenticated application shell; noindex"},
    {"file":"klantportaal-demo.html","reason":"application/demo shell; noindex"},
    {"file":"index-oud.html","reason":"non-canonical archived artifact; noindex"}
  ],
  "strategicDestinations": [
    "/bedrijfsgeheugen",
    "/bedrijfsprocessen-automatiseren",
    "/systemen-koppelen",
    "/afas-koppeling",
    "/exact-online-koppeling",
    "/twinfield-koppeling",
    "/api-koppeling-laten-maken",
    "/ai-adoptie",
    "/ai-governance",
    "/ai-act",
    "/data-soevereiniteit",
    "/benchmark",
    "/blog/",
    "/over-ons",
    "/contact",
    "/privacy"
  ],
  "rules": {
    "exactlyOneFooter": true,
    "footerChangesRequireSeoGreen": true,
    "anchorsMustMatchKeywordStrategy": true,
    "noDeadFooterLinks": true,
    "noKeywordCannibalization": true,
    "v18OnlyFooterMayChange": true,
    "crawlableServerRenderedHtml": true,
    "exceptionsMustExistAndBeNoindex": true
  }
}
